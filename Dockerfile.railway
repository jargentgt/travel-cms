# Production Dockerfile for Railway deployment
FROM node:22.17.0-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies with pnpm
RUN corepack enable pnpm && pnpm install --frozen-lockfile --prod=false

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set production environment for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build the application with railway-specific settings
RUN corepack enable pnpm && pnpm run build:railway

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Create public directory if it exists
COPY --from=builder /app/public* ./public

# Create .next directory with correct permissions
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Create uploads directory for Railway volume (run as root initially)
RUN mkdir -p /app/uploads

# Railway automatically provides PORT environment variable
EXPOSE 3000

# Run as root to handle volume permissions, then start the application
CMD ["sh", "-c", "echo 'Setting up upload directory permissions...' && mkdir -p /app/uploads && chmod 777 /app/uploads && chown -R root:root /app/uploads 2>/dev/null || true && echo 'Starting application...' && HOSTNAME=0.0.0.0 PORT=${PORT:-3000} node server.js"] 